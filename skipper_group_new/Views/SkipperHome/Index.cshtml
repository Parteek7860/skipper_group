@model skipper_group_new.Models.clsHomeModel
@using System.Data
@using skipper_group_new.mainclass
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
    DataTable dtnews = ViewBag.Newslist as DataTable;
    DataTable dt1 = ViewBag.BannerList as DataTable;
    DataTable dtpopup = ViewBag.PopupBannerList as DataTable;
}
@if(dtpopup !=null)
{
    
<div class="popup-overlay" id="popup">
    <div class="popup-content">
        <div class="close-btn" id="closePopup">×</div>
        
        <a href="@Convert.ToString(dtpopup.Rows[0]["url"])">
            <img src="/uploads/banner/@Convert.ToString(dtpopup.Rows[0]["bannerimage"])" alt="@Convert.ToString(dtpopup.Rows[0]["title"])">
        </a>
    </div>
</div>
    
}

<!---------header html start here--------->
<header class="position-fixed d-flex align-items-center justify-content-between w-full">
    <div class="logo">
        <a href="/">
            <img width="250" height="78" src="~/images/logo/logo.png" class="img-fluid before-sticky"
                 alt="SKIPPER LIMITED">
            <img width="250" height="78" src="~/images/logo/logo-sticky.png" class="img-fluid after-sticky"
                 alt="SKIPPER LIMITED">
        </a>
        <div class="globe-dropdown">
            <a class="globe-icon">
                <img src="/images/globe-icon.png" alt="Globe">
            </a>

            <ul class="globe-menu">
                <li><a href="https://us.skipperlimited.com/" target="_blank">Skipper North America </a></li>
                <li><a href="https://skippermetzer.com/" target="_blank">Skipper Metzer</a></li>
            </ul>
        </div>
    </div>
    @await Html.PartialAsync("~/Views/PartialView/_MainMenu_new.cshtml")
</header>

@if(dt1!=null)
{
@if (dt1.Rows.Count > 0)
{
    
    <section class="home_banner">

        @if (Convert.ToString((dt1.Rows[0]["btype"])) == "Video")
        {
             var userAgent = Context.Request.Headers["User-Agent"].ToString();
            bool isMobile = userAgent.Contains("Android") ||
                            userAgent.Contains("iPhone") ||
                            userAgent.Contains("Mobile");
            @if (Convert.ToString((dt1.Rows[0]["btype"]))=="Video" && Convert.ToBoolean((dt1.Rows[0]["desktopstatus"]))==true && isMobile==false)
            {
                <div style="padding:56.25% 0 0 0;position:relative;"><iframe src="https://player.vimeo.com/video/1164623707?controls=0&amp;badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479&amp;autoplay=1&amp;muted=1&amp;loop=1" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="edit 1 - Hori - Chgs.09feb-"></iframe></div>
    
                
            }
            else
            {
                <div style="padding:177.78% 0 0 0;position:relative;">
                   <iframe src="https://player.vimeo.com/video/1164623876?controls=0&amp;badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479&amp;autoplay=1&amp;muted=1&amp;loop=1" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="edit 1-verticle - Chgs. 09feb - 1080x1920"></iframe></div>
            
            }
            <script src="https://player.vimeo.com/api/player.js"></script>
           
            

        }
        else
        {
          <div class="swiper home_slider">
                <div class="swiper home_slider">
                    <div class="swiper-wrapper">
                        @foreach(DataRow ro in dt1.Rows)
                        {
                             <div class="swiper-slide">
                            <picture>
                                <source media="(min-width:992px)" srcset="/uploads/banner/@Convert.ToString((ro["bannerimage"]))">
                                <img src="/uploads/banner/@Convert.ToString((ro["mobileimage"]))" alt="banner" class="img-fluid w-100">
                                <figcaption>
                                @Html.Raw(Convert.ToString(ro["tagline1"]))
                               	</figcaption>
                            </picture>
                        </div>
                        <!--slide-end-->
                        }
                       
                     
                    </div>
                </div>
            </div>
        }
    </section>
}    
}


@Html.Raw(Model.SmallDescription)
<div class=wrapper>
    <div class=eng-wrapper>
        <section class="animated-section home_eng">
            @Html.Raw(Model.cmscontent)
        </section>
        <section class="home_eng1">
            <div class="container">
                <div class="second-vertical-line-svg">
                    <svg viewBox="0 0 1 200" preserveAspectRatio="none">
                        <line x1="0.5" y1="0" x2="0.5" y2="200" />
                    </svg>
                </div>
                <div class="second-dot"></div>
                <div class="horizontal-line2"></div>

                <div class="eng_gorup_img">
                    <figure class="engineering-image">
                        <div class="image-reveal-mask mobile-none">
                            <img src="images/eng-pic.webp" class="img-fluid" alt="Engineering" />
                        </div>
                        <div class="image-reveal-mask mobile-display">
                            <img src="images/eng-pic-mobile.webp" class="img-fluid" alt="Engineering" />
                        </div>
                    </figure>

                    <div class="engineering-bg"></div>
                    <div class="text_eng">
                        <div class="eng_text1">
                            <figure>
                                <img src="images/icon/Subtraction-1.svg" class="img-fluid" alt="skipper image" />
                            </figure>
                            <div class="eng_pic1">
                                <h3>Engineering</h3>
                                <p>
                                    One of World's largest  <br />integrated Transmission Tower  and <br />Pole manufacturing companies
                                </p>
                                <div class="read_icon">
                                    <a href="/engineering/1"><img src="images/icon/plus-icon.svg" alt="skipper image" /></a>
                                </div>
                            </div>
                        </div>
                        <div class="eng_text2">
                            <h4>375K</h4>
                            <p>MTPA engineering <br /> production capacity</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section class="home_infra animated-section1">
            @Html.Raw(Model.pagedesc2)
        </section>
    </div>
    <section class="home_people">
        @Html.Raw(System.Net.WebUtility.HtmlDecode(Model.pagedesc3))
    </section>
    <section class="home_sustainbility">
        @Html.Raw(Model.megamenu)
    </section>
    @if (ViewBag.ProjectsList != null)
    {

        <section class=featured_project>
            <div class=scroll-spacer></div>
            <div class=trigger-placeholder></div>
            <div class=icon_project>
                <figure><img src=/images/icon/Subtraction-4.svg alt="skipper image" class=img-fluid></figure>
            </div>
            <div class=container>
                <h2>Featured Projects</h2>
                <div class=project_slider>
                    <div class="mySwiper swiper">
                        <div class=swiper-wrapper>
                            <div class=swiper-slide>
                                <div class=swiper-container>
                                    <div class=slider_grid>
                                        @{
                                            var dt = ViewBag.ProjectsList as DataTable;
                                        }


                                        <div class=right-container id=panelright>


                                            @if (dt != null && dt.Rows.Count > 1)
                                            {
                                                @foreach (DataRow data in dt.Rows)
                                                {
                                                    <div class=right-top>
                                                        <div class=corner-accent>
                                                            <figure>
                                                                <img src=/uploads/SmallImages/@data["uploadevents"]
                                                                     alt="skipper image" class=img-fluid>
                                                            </figure>
                                                        </div>
                                                        <div class=text-content>
                                                            <div class=bottom_left_icon>
                                                                <img src=images/icon/Subtraction-6.svg class=img-fluid>
                                                            </div>
                                                            <div class=project-title>
                                                                @data["researchtitle"]
                                                            </div>
                                                            <div class=description>
                                                                @data["tagline"]
                                                                <div class=loctn_grid>
                                                                    <div class=prjt_nme>
                                                                        <h4>Project Authority</h4>
                                                                        <p>Ceylon Electricity Board (CEB)
                                                                    </div>
                                                                    <div class=prjt_nme>
                                                                        <h4>Location</h4>
                                                                        <p>@data["location"]</p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class=voltage></div>
                                                        <a href="/project-details/@Convert.ToString(@data["researchtitle"]).ToLower().ToSlug()/@data["researchid"]"
                                                           class=streched_link></a>
                                                    </div>
                                                }

                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="button_group d-none">
                            <div class=container>
                                <div class=swiper-button-next></div>
                                <div class=swiper-button-prev></div>
                            </div>
                        </div>
                        <div class=container>
                            <div class=view_all>
                                <a href="/projects">
                                    View All Projects
                                    <figure><img src=/images/icon/right_icon.svg alt="project icon"></figure>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    }

    @if (dtnews.Rows.Count > 0)
    {
        <section class=skipper_news>
            <div class=full_container>
                <div class=item>
                    <figure><img src=/images/skipper_news.png alt="skipper news" class=img-fluid></figure>
                </div>
                @if (dtnews.Rows.Count > 0)
                {
                    foreach (DataRow row in dtnews.Rows)
                    {
                        <div class=item>
                            <div class=home_news>
                                <figure>
                                    <img src=/uploads/smallimages/@Convert.ToString(row["uploadevents"]) alt="@Convert.ToString(row["eventstitle"])" class=img-fluid>
                                </figure>
                                <div class="fade-container home_news_detail">
                                    <div class="h_date">
                                        @(row["eventsdate"] == DBNull.Value
                                                                    ? ""
                                                                    : Convert.ToDateTime(row["eventsdate"]).ToString("dd-MMM-yyyy"))
                        </div>
                        <h3>@Convert.ToString(row["eventstitle"])</h3>
                    </div><a href=/news-details/@Convert.ToString(row["eventstitle"]).ToSlug()/@Convert.ToInt32(row["eventsid"]) class=streched_link></a>
                </div>
            </div>
                        }
                }
            </div>
            <div class=view_all>
                <a href="/whats-new">
                    View All News & Updates
                    <figure>
                        <img src=/images/icon/right_icon.svg alt="nes icon">
                    </figure>
                </a>
            </div>
        </section>
    }


</div>


