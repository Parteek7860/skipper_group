@using System.Data;
@model skipper_group_new.Models.clsProduct;

@{
    Layout = "~/Views/Shared/_cms.cshtml";
    DataTable dtprojectlist = ViewBag.GalleryList as DataTable;
}
@if (Model != null)
{
    <section class="inner_banner">
        @{
            var userAgent = Context.Request.Headers["User-Agent"].ToString();

            bool isMobile =
            userAgent.Contains("Android") ||
            userAgent.Contains("iPhone") ||
            userAgent.Contains("Mobile");

            string bannerImage = "";

            if (isMobile && !string.IsNullOrEmpty(Model.uploadmobileimage))
            {
                bannerImage = "/uploads/banner/" + Model.uploadmobileimage;
            }
            else
            {
                bannerImage = "/uploads/productsimage/" + Model.UploadAImage;
            }
        }
        @if (!string.IsNullOrEmpty(bannerImage))
        {
            <figure>
                <img src="@Convert.ToString(bannerImage)" alt="@Model.ProductName" class="img-fluid w-100" />
            </figure>
        }

        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="breadcrumb-bar">
                        <div class="breadcrumb-left">
                            <h5>Product & Solution</h5>
                        </div>
                        <div class="breadcrumb-right">
                            <a href="/">Home</a><img src="/images/icon/arrow-right.webp" alt="arrow-right">
                            <span>Product & Solution</span>
                        </div>
                    </div>
                    <div class="bread_btm">
                        <h5>@Convert.ToString(Model.ProductName)</h5>
                    </div>
                    <div class="shrt-title">
                        <h6>
                            @Html.Raw(Model.ProductTitle)
                        </h6>
                    </div>


                </div>
            </div>
        </div>
    </section>
    @Html.Raw(Model.ShortDetail.ToString())
    @Html.Raw(Model.ProductDetail.ToString())
    @Html.Raw(Model.LongDesc.ToString())
    @Html.Raw(Model.LongDesc2.ToString())

    @if (dtprojectlist != null)
    {
        <section class="prodct_six">
            <div class="container">
                <h2>Gallery</h2>

                <section class="gallery-section">
                    <div class="gallery-grid">
                        @if (dtprojectlist.Rows.Count > 0)
                        {
                            foreach (DataRow row1 in dtprojectlist.Rows)
                            {
                                <div class="gallery-card">
                                    <div class="gallery_img_bg">
                                        <img src="/uploads/LargeImages/@Convert.ToString(row1["uploadaimage"])" alt="@Convert.ToString(row1["albumtitle"])">
                                    </div>
                                    <p>@Convert.ToString(row1["albumtitle"])</p>
                                </div>
                            }
                        }
                    </div>
                </section>
            </div>
        </section>
    }


}

