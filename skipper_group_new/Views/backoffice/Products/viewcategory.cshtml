@using System.Data
@{
    Layout = "~/Views/Shared/_homepage.cshtml";
    ViewBag.Title = "View Category";
}

<div class="block-header">
    <div class="row">
        <div class="col-lg-7 col-md-6 col-sm-12">
            <h2>
                @ViewBag.Title
                <small class="text-muted">@Context.Session.GetString("ClientName")</small>
            </h2>
        </div>
        <div class="col-lg-5 col-md-6 col-sm-12">
            <ul class="breadcrumb float-md-right">
                <li class="breadcrumb-item"><a href="#"><i class="zmdi zmdi-home"></i> Category </a></li>
                <li class="breadcrumb-item active">View Category</li>
            </ul>
        </div>
    </div>
</div>

<div class="row clearfix">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <div class="card">
            <div class="body">
                @{
                    var cat = ViewBag.CateDtl as DataTable;
                }
                @if (cat != null && cat.Rows.Count > 0)
                {
                    <h2 class="card-inside-title">
                        Fields with * are mandatory
                    </h2>
                    <input type="text" id="searchInput" class="form-control" placeholder="Search..." onkeyup="searchTable()" />
                    <div class="row" style="margin-top:20px;">
                        <div class="col-lg-4">
                            <label for="fromDate" style="font-weight: bold;">From Date</label>
                            <input type="date" id="fromDate" class="form-control" style="border-radius: 5px; border: 1px solid #ddd;" />
                        </div>
                        <div class="col-lg-4">
                            <label for="toDate" style="font-weight: bold;">To Date</label>
                            <input type="date" id="toDate" class="form-control" style="border-radius: 5px; border: 1px solid #ddd;" />
                        </div>
                    </div>
                    <div class="row" style="margin-bottom: 20px;">
                        <div class="col-lg-2" style="padding-top:10px;">
                            <button class="btn btn-primary" type="button" onclick="filterByDate()" style="width: 50%; padding: 10px; border-radius: 5px; font-weight: bold;background-color:#456976 !important">Search</button>
                        </div>
                        <div class="col-md-2 align-self-end" style="text-align: center;">
                            <form method="post" asp-controller="Products" asp-action="ExportCategoryToExcel">
                                <button type="submit" class="btn btn-success" style="width: 50%; padding: 10px; border-radius: 5px; font-weight: bold;background-color:#456976 !important">Export to Excel</button>
                            </form>
                        </div>
                    </div>
                    <table class="table table-bordered" id="categoryTable">
                        <thead class="table-header">
                            <tr>
                                <th>Product Type</th>
                                <th>Category Name</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (DataRow c in cat.Rows)
                            {
                            <tr>
                                    <td>@c["productname"]</td>
                                <td>@c["Category"]</td>
                              
                                <td>@Convert.ToDateTime(c["trdate"]).ToShortDateString()</td> 
                                <td>
                                    @{
                                        bool isActive = c["Status"] != DBNull.Value && Convert.ToBoolean(c["Status"]);
                                        var id = c["PcatId"];
                                    }

                                    @if (isActive)
                                    {
                                        <form method="get" action="/Backoffice/Products/ChangeCatStatus/@id" style="display:inline;">
                                            <button type="submit" class="btnstatus border-0 bg-transparent" onclick="return confirm('You want to change the status to inactive?');">
                                                <img src="~/Backoffice/images/active.png" width="25" alt="Active" />
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="get" action="/Backoffice/Products/ChangeCatStatus/@id" style="display:inline;">
                                            <button type="submit" class="btnstatus border-0 bg-transparent" onclick="return confirm('You want to change the status to active?');">
                                                <img src="~/Backoffice/images/wrong.png" width="25" alt="Inactive" />
                                            </button>
                                        </form>
                                    }
                                </td>
                                <td>
                                    <a href="/Backoffice/Products/GetCategoryByID/@id" class="btnEdit">
                                        <img src="~/Backoffice/images/edit.png" class="img-fluid" width="20" alt="Edit" />
                                    </a>

                                    <a href="#" class="btndelete" data-href="/Backoffice/Products/DeleteCategory/@id">
                                        <img src="~/Backoffice/images/delete.png" class="img-fluid" width="20" alt="Delete" />
                                    </a>

                                        <a href="#" class="btnMap" data-id="@id" onclick="return false;">
                                            <img src="~/backoffice/images/addicon.png" class="img-fluid" width="20" alt="MapAlbum" />
                                        </a>
                                    </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p style="margin-left:400px">No category found.</p>
                }

            </div>
        </div>
    </div>
</div>

<!-- Map Album Modal -->
<div class="modal fade" id="mapAlbumModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Map Album</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="mapAlbumModalBody"></div>
        </div>
    </div>
</div>
@{
    var nonce = Context.Items["CSPNonce"]?.ToString();
}
<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function () {
        const deleteButtons = document.querySelectorAll('.btndelete');
        deleteButtons.forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const confirmed = confirm("Are you sure you want to delete this record?");
                if (confirmed) {
                    window.location.href = btn.getAttribute('data-href');
                }
            });
        });

        document.querySelectorAll('.btnMap').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                var id = this.getAttribute('data-id');

                fetch('/backoffice/products/mapalbum/' + id)
                    .then(res => res.text())
                    .then(html => {
                        document.getElementById('mapAlbumModalBody').innerHTML = html;
                        $('#mapAlbumModal').modal('show');
                    })
                    .catch(err => alert('Error loading albums: ' + err));
            });
        });
    });

    function searchTable() {
        var input, filter, table, tr, td, i, j, txtValue;
        input = document.getElementById('searchInput');
        filter = input.value.toLowerCase();
        table = document.getElementById('categoryTable');
        tr = table.getElementsByTagName('tr');
        for (i = 1; i < tr.length; i++) {
            td = tr[i].getElementsByTagName('td');
            let matchFound = false;
            for (j = 0; j < td.length; j++) {
                if (td[j]) {
                    txtValue = td[j].textContent || td[j].innerText;
                    if (txtValue.toLowerCase().indexOf(filter) > -1) {
                        matchFound = true;
                        break;
                    }
                }
            }
            if (matchFound) {
                tr[i].style.display = "";
            } else {
                tr[i].style.display = "none";
            }
        }
    }

    function filterByDate() {
        const fromDateInput = document.getElementById('fromDate').value;
        const toDateInput = document.getElementById('toDate').value;

        const fromDate = fromDateInput ? new Date(fromDateInput) : null;
        const toDate = toDateInput ? new Date(toDateInput) : null;

        if (toDate) {
            toDate.setDate(toDate.getDate() + 1);
        }

        const table = document.getElementById('categoryTable');
        const tr = table.getElementsByTagName('tr');

        for (let i = 1; i < tr.length; i++) {
            const td = tr[i].getElementsByTagName('td')[2];
            if (td) {
                const trDate = new Date(td.textContent || td.innerText);
                let showRow = true;

                if (fromDate && trDate < fromDate) {
                    showRow = false;
                }

                if (toDate && trDate >= toDate) {
                    showRow = false;
                }

                tr[i].style.display = showRow ? "" : "none";
            }
        }
    }

    // --- Album mapping functions ---
    function toggleAllAlbums(src) {
        document.querySelectorAll('.albumChk').forEach(c => c.checked = src.checked);
    }

    function filterAlbumCheckboxes() {
        var input = document.getElementById('albumSearchInput');
        if (!input) return;
        var filter = input.value.toLowerCase();
        document.querySelectorAll('#albumMapTable tbody tr').forEach(r => {
            var txt = r.cells[1].textContent.toLowerCase();
            r.style.display = txt.indexOf(filter) > -1 ? "" : "none";
        });
    }

    function saveAlbumMapping() {
        var productIdInput = document.querySelector('#mapAlbumForm input[name="productId"]');
        if (!productIdInput) return;

        var productId = productIdInput.value;
        var albumIds = Array.from(document.querySelectorAll('.albumChk:checked')).map(c => parseInt(c.value));

        fetch('/backoffice/products/savealbummap', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: parseInt(productId), albumIds: albumIds })
        })
        .then(res => res.json())
        .then(data => {
            alert(data.message);
            if (data.success) {
                $('#mapAlbumModal').modal('hide');
            }
        })
        .catch(err => alert('Error: ' + err));
    }

    setTimeout(function () {
        var msg = document.getElementById("message");
        if (msg) {
            msg.style.display = "none";
        }
    }, 2000);
</script>
