@using System.Data
@model skipper_group_new.Models.clsRedirection;
@{
    Layout = "~/Views/Shared/_homepage.cshtml";
    ViewBag.Title = "Add 301 Redirection Management";
    var RedirectionList = ViewBag.RedirectionList as System.Data.DataTable;
}
<div class="block-header">
    <div class="row">
        <div class="col-lg-7 col-md-6 col-sm-12">
            <h2>
                @ViewBag.Title
                <small class="text-muted">@Context.Session.GetString("ClientName")</small>
            </h2>
        </div>
        <div class="col-lg-5 col-md-6 col-sm-12">
            <ul class="breadcrumb float-md-right">
                <li class="breadcrumb-item"><a href="#"><i class="zmdi zmdi-home"></i> Redirection Management</a></li>
                <li class="breadcrumb-item active">Redirection</li>
            </ul>
        </div>
    </div>
</div>
@using (Html.BeginForm("redirection", "redirectionmanagement", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="body">
                    <h2 class="card-inside-title">
                        Fields with * are mandatory
                    </h2>
                    @Html.HiddenFor(mbox => mbox.Id)
                    @Html.HiddenFor(mbox => mbox.status)
                    @Html.HiddenFor(mbox => mbox.redirect_type)
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>Old Url</label>
                                    @Html.TextBoxFor(model => model.OldUrl, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.OldUrl, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>New Url</label>
                                    @Html.TextBoxFor(model => model.NewUrl, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.NewUrl, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-lg-6 col-md-6 col-sm-6">

                            <input type="submit" class="btn btn-success btn-lg mx-2" formmethod="post" @Url.Action("redirection", "redirectionmanagement") value="@ViewBag.SaveUpdate" />
                        </div>
                    </div>


                </div>
            </div>
        </div>
    </div>

}

<div class="row clearfix" style="padding-top:50px;">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <div class="card">
            <div class="body">
                @if (RedirectionList != null && RedirectionList.Rows.Count > 0)
                {
                    <div class="col-sm-12">
                        <table class="table table-bordered" id="productTable">
                            <thead class="table-header">
                                <tr>
                                    <th>Old Url</th>
                                    <th>New Url</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (DataRow row in RedirectionList.Rows)
                                {
                                    <tr>
                                        <td>@(Convert.ToString(row["old_url"]))</td>
                                        <td>@(Convert.ToString(row["new_url"]))</td>

                                        <td>
                                            @if (Convert.ToBoolean(row["Status"]) == true)
                                            {
                                                <a data-value="@(Convert.ToString(row["id"]))"
                                                   href="/backoffice/redirectionmanagement/datastatus/@row["id"]" class="btnedit" onclick="return confirm('You want to change the status to active?');">
                                                    <img src="~/backoffice/images/active.png" width="25" />
                                                </a>
                                            }
                                            else
                                            {
                                                <a data-value="@(Convert.ToString(row["id"]))"
                                                   href="/backoffice/redirectionmanagement/datastatus/@row["id"]" class="btnedit" onclick="return confirm('You want to change the status to In-active?');">
                                                    <img src="~/backoffice/images/wrong.png" width="25" />
                                                </a>
                                            }
                                        </td>
                                        <td>
                                            <form method="get" action="/backoffice/redirectionmanagement/redirectdelete/@row["id"]" style="display: inline;">
                                                <button type="submit" class="btnstatus" style="border:none;background:none" onclick="return confirm('You want to change the status to active?');">
                                                    <img src="~/backoffice/images/delete.png" class="img-fluid" width="20" alt="Delete" />
                                                </button>
                                            </form>
                                            @*   <a data-value="@(Convert.ToString(row["id"]))" class="btndelete" href="/backoffice/redirectionmanagement/redirectdelete/@row["id"]">
                                                        <img src="~/backoffice/images/delete.png" class="img-fluid" width="20" alt="Delete" />
                                                    </a> *@
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="pagination-container text-center mt-3" style="text-align:right;">
                            <input id="prevPage" type="button" class="btn btn-secondary" style="background-color:#456976;" value="Previous" />
                            <span id="pageInfo" class="mx-2"></span>
                            <input id="nextPage" type="button" class="btn btn-secondary" style="background-color:#456976;" value="Next" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-lg-12 my-lg-2 text-lg-center message-top2">
                        Records not found
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@{

    var nonce = Context.Items["CSPNonce"]?.ToString();
}

<script nonce="@nonce">
    document.addEventListener('DOMContentLoaded', function () {
        const deleteButtons = document.querySelectorAll('.btndelete');
        deleteButtons.forEach(btn => {
            btn.addEventListener('click', e => {
                e.preventDefault();
                if (confirm("Are you sure you want to delete this record?")) {
                    window.location.href = btn.getAttribute('data-href');
                }
            });
        });
    });


    let currentPage = 1;
    const rowsPerPage = 10;
    function paginateTable() {
        const table = document.getElementById('productTable');
        const rows = table.querySelectorAll('tbody tr');
        const totalRows = rows.length;
        const totalPages = Math.ceil(totalRows / rowsPerPage);
        rows.forEach(row => row.style.display = 'none');
        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;
        rows.forEach((row, index) => {
            if (index >= start && index < end) {
                row.style.display = '';
            }
        });
        document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;
        document.getElementById('prevPage').disabled = currentPage === 1;
        document.getElementById('nextPage').disabled = currentPage === totalPages;
    }

    document.getElementById('prevPage').addEventListener('click', () => {
        if (currentPage > 1) {
            currentPage--;
            paginateTable();
        }
    });

    document.getElementById('nextPage').addEventListener('click', () => {
        const table = document.getElementById('productTable');
        const rows = table.querySelectorAll('tbody tr');
        const totalPages = Math.ceil(rows.length / rowsPerPage);
        if (currentPage < totalPages) {
            currentPage++;
            paginateTable();
        }
    });
    document.addEventListener('DOMContentLoaded', paginateTable);

</script>