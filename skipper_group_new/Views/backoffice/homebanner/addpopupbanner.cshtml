@model skipper_group_new.Models.clsbanner

@{
    ViewData["Title"] = "Add Popup Banner";
    Layout = "~/Views/Shared/_homepage.cshtml";
}
<div class="block-header">
    <div class="row">
        <div class="col-lg-7 col-md-6 col-sm-12">
            <h2>
                @ViewBag.Title
                <small class="text-muted">@Context.Session.GetString("ClientName")</small>
            </h2>
        </div>
        <div class="col-lg-5 col-md-6 col-sm-12">
            <ul class="breadcrumb float-md-right">
                <li class="breadcrumb-item"><a href="#"><i class="zmdi zmdi-home"></i> Blog</a></li>
                <li class="breadcrumb-item active">Add Blogs</li>
            </ul>
        </div>
    </div>
</div>


@using (Html.BeginForm("AddEditPopupBanner", "HomeBanner", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">
                <div class="body">
                    <h2 class="card-inside-title">
                        Fields with * are mandatory
                    </h2>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label> Type</label>
                                    @Html.HiddenFor(model => model.id)
                                    @Html.HiddenFor(model => model.status)
                                    @Html.HiddenFor(model => model.collageid)
                                    @Html.DropDownListFor(model => model.bannertype, Model.bannertypeselect, "Select Banner", new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.bannertype, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>Page Title</label>
                                    @Html.TextBoxFor(m => m.name, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>Popup Date</label>
                                    @Html.TextBoxFor(m => m.startdate, new { @class = "form-control", type = "date" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>Popup End Date</label>
                                    @Html.TextBoxFor(m => m.enddate, new { @class = "form-control", type = "date" })
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>Upload Pop Banner</label>
                                    <input type="file" name="PopupBannerFile" class="form-control" />
                                    <img src="/uploads/banner/@Url.Content(Model.bannerlogo)" width="80" />
                                    @Html.HiddenFor(m => m.bannerlogo)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>Url</label>
                                    @Html.TextBoxFor(m => m.url, new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <div class="form-line">
                                    <label>Display Order</label>
                                    @Html.TextBoxFor(m => m.displayorder, new { @class = "form-control", type = "number" })
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-lg-6 col-md-6 col-sm-6">
                            <button type="submit" class="btn btn-success btn-lg mx-2" value="Save">@ViewBag.CreateUpdate</button>
                            <a href="/backoffice/blogs/view-blogs" class="btn btn-secondary btn-lg mx-2">Cancel</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="~/ckeditor/ckeditor.js"></script>
<script>
    $('.editor1').each(function () {
        CKEDITOR.replace($(this).prop('id'));
    });
</script>