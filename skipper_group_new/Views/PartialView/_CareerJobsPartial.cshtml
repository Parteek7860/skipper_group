@using System.Data
@using skipper_group_new.mainclass;
@model DataTable

@if (Model != null && Model.Rows.Count > 0)
{
    <div class="row">
        @foreach (DataRow row in Model.Rows)
        {
            <div class="col-lg-4">
                <div class="job-posting">
                    <h2>@row["jobtitle"]</h2>

                    <div class="company-info">

                        <p>
                            <strong>Job Location:</strong>
                            <span>@row["location"]</span>
                        </p>
                        <p>
                            <strong>Qualification:</strong>
                            <span>
                                @Html.Raw(System.Net.WebUtility.HtmlDecode(Convert.ToString(@row["Qualification"])))
                            </span>
                        </p>
                    </div>

                    <div class="required-experience">
                        <p>
                            <strong>Experience:</strong>
                            <span>@row["min_expyear"] - @row["max_expyear"] years</span>
                        </p>
                    </div>
                    <div class="required-experience">
                        <p>
                            <strong>
                                No.of Openings
                                :
                            </strong>
                            <span>
                                @row["no_of_vac"]
                            </span>
                        </p>
                    </div>
                    <div class="button-container">
                        <a href="#">Share</a>
                        <a href="/career-details/@Convert.ToString(row["jobtitle"]).ToSlug().ToLower()/@row["jobid"]">
                            Apply
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

