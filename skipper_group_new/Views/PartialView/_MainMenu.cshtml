@using System.Data
@using skipper_group_new.Models
@inject skipper_group_new.Service.MenuDataService MenuService
@using skipper_group_new.mainclass;
@{
    var leftHam = MenuService.HamBurgerList;
    var mainmenu = MenuService.MainMenuList;
    var investorlist = MenuService.InvestorList;
    var productlist = MenuService.productlist;

    DataTable dtmenu = ViewBag.MenuList as DataTable;
    DataTable dthamburgar = ViewBag.SubHamburger as DataTable;
    List<DataRow> mainmenuFiltered = new List<DataRow>();
    if (dtmenu != null)
    {
        mainmenuFiltered = dtmenu.AsEnumerable()
                                .Where(r => r.Field<int>("collageid") != 0).ToList();
    }

}
<style>

    .globe-dropdown {
        position: relative;
        display: inline-block;
        margin-left: 0;
    }

    .globe-icon img {
        width: 28px;
        cursor: pointer;
    }

    .globe-menu {
        display: none;
        position: absolute;
        right: 0;
        top: 5rem;
        background: #fff;
        min-width: 251px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
        list-style: none;
        padding: 3rem 0;
        margin: 0;
        z-index: 999;
        width: 100%;
    }

        .globe-menu li a {
            display: block;
            padding: 0px 1rem;
            color: #333;
            text-decoration: none;
            margin-top: 0;
            font-size: var(--font-21);
        }

            .globe-menu li a:hover {
                background: #f2f2f2;
            }

    /* Show dropdown on hover */
    .globe-dropdown:hover .globe-menu {
        display: block;
    }


    .globe-menu li:not(:last-child) {
        margin-bottom: 2rem;
    }

    .globe-menu li:hover a {
        color: var(--color00);
        background-color: transparent;
    }

</style>
@if (mainmenuFiltered.Count > 0)
{
    @if (dtmenu != null)
    {
        <ul class="d-flex align-items-center justify-content-between">
            @foreach (DataRow row1 in dtmenu.Rows)
            {
                var href = !string.IsNullOrEmpty(Convert.ToString(row1["rewriteurl"]))
                ? $"/{Convert.ToString(row1["rewriteurl"])}"
                : $"/cms/{Convert.ToString(row1["linkname"]).ToSlug()}/{Convert.ToInt32(row1["pageid"])}/{Convert.ToInt32(row1["collageid"])}";
                <li>
                    <a href="@href">@Convert.ToString(row1["linkname"])</a>
                </li>
            }
            <li class="ps_d"><a href="javascript:void(0)">Enquiry Now</a></li>
            <li class="ps_d blu_clr">
                <a href="/">
                    Skipper Group <img src="images/icon/arrow-right.webp"
                                       alt="">
                </a>
            </li>
            <div class="top-humburger">
                <div class="c-hamburger c-hamburger--htx">
                    <a href="javascript:void(0)">
                        <img src="/images/icon/humburger-icon.svg" class="img-fluid" />
                    </a>
                </div>
                @{
                    string hamburgerengclass = "eng_icon";

                }
                <nav class="sub-menu open">
                    <div id="accordian" class="@hamburgerengclass">
                        <ul class="list-unstyled">
                            @if (dthamburgar != null)
                            {
                                @foreach (DataRow row in dthamburgar.Rows)
                                {
                                    var subHref = !string.IsNullOrEmpty(Convert.ToString(row["rewriteurl"]))
                                    ? $"/{Convert.ToString(row["rewriteurl"])}"
                                    : $"/cms/{Convert.ToString(row["linkname"]).ToSlug()}/{Convert.ToInt32(row["pageid"])}/{Convert.ToInt32(row["collageid"])}";
                                    <li class="no_drop_menu">
                                        <h3>
                                            <a href="@subHref">@Convert.ToString(row["linkname"])</a>
                                        </h3>
                                    </li>
                                }
                            }


                        </ul>
                    </div>
                </nav>
            </div>
        </ul>
    }

}
else
{
    <nav>
        <ul class="align-items-center d-flex justify-content-between">
            @if (mainmenu != null && mainmenu.Count > 0)
            {
                @foreach (var menu in mainmenu)
                {
                    string parentclass = "";
                    string aboutclass = "";
                    if (menu.pageid == "6")
                    {
                        parentclass = "sutain_d";
                    }
                    if (menu.pageid == "4")
                    {
                        parentclass = "investor_mega_menu";
                    }
                    if (menu.pageid == "2")
                    {
                        aboutclass = "about-menu";
                    }
                    if (menu.pageid == "7")
                    {
                        parentclass = "ps_d";
                    }
                    if (menu.pageid == "8")
                    {
                        parentclass = "people_mega_menu";
                    }



                    var subHref = !string.IsNullOrEmpty(menu.rewriteurl)
                    ? $"/{menu.rewriteurl}"
                    : $"/cms/{menu.linkname}/{menu.pageid}";

                    var currentPath = Context.Request.Path.Value.ToLower();

                    bool isActive =
                    currentPath == subHref;

                    <li class="menu-item menudrop-item @parentclass">

                        <a class="@(isActive ? "active" : "")" href="@((menu.SubMenus != null && menu.SubMenus.Count > 0) || menu.pageid == "7" ? "javascript:void(0)" : subHref)">
                            @menu.Name

                        </a>

                        @if (menu.pageid == "2" || menu.pageid == "6")
                        {
                            @if (menu.SubMenus != null && menu.SubMenus.Count > 0)
                            {
                                <div class="mega_dropdown mega_dropdown01">
                                    <div class=menu_tower_icon1>
                                        <figure><img src=/images/icon2/about-tower1.svg class=img-fluid></figure>
                                    </div>
                                    <div class=menu_tower_icon2>
                                        <figure><img src=/images/icon2/about-tower1.svg class=img-fluid></figure>
                                    </div>
                                    <div class=mega_item_left>
                                        <ul>
                                            @{
                                                int i = 1;
                                            }
                                            @foreach (var submenu in menu.SubMenus)
                                            {
                                                string activeClass = i == 1 ? "active" : "";
                                                @*  var subHref1 = !string.IsNullOrEmpty(submenu.rewriteurl)
                                                ? $"/{submenu.rewriteurl}"
                                                : $"/cms/{submenu.linkname}/{submenu.pageid}"; *@
                                                var subHref1 = !string.IsNullOrEmpty(submenu.rewriteurl)
                                                ? $"/{submenu.rewriteurl}"
                                                : $"javascript:void()";
                                                <li class="dropmenu @activeClass" data-target=.drop_menu_@i>
                                                    <a href="@subHref1">@submenu.linkname</a>
                                                </li>
                                                i++;
                                            }
                                        </ul>
                                    </div>

                                    <div class="mega_item_right @aboutclass">

                                        @{
                                            i = 1;
                                            string classnanme = "";
                                            if (menu.pageid == "6")
                                            {
                                                classnanme = "sustain_box";
                                            }
                                        }
                                        @foreach (var submenu in menu.SubMenus)
                                        {
                                            string activeClass = i == 1 ? "active show" : "";
                                            <div class="mega_dropmenu @classnanme drop_menu_@i @activeClass" data-target=.drop_menu_@i>
                                                <div class="mega_border"></div>
                                                @Html.Raw(System.Net.WebUtility.HtmlDecode(submenu.smalldesc))
                                                @if (submenu.SubMenus2 != null)
                                                {
                                                    <div class="sustain_link_text">
                                                        <ul>
                                                            @foreach (var submenu2 in submenu.SubMenus2)
                                                            {
                                                                string actionLink = string.Empty;
                                                                if (!string.IsNullOrEmpty(submenu2.uploadfile))
                                                                {
                                                                    actionLink = "target=_blank";
                                                                }

                                                                var subHref1 =
                                                                !string.IsNullOrEmpty(submenu2.rewriteurl)
                                                                ? $"/{submenu2.rewriteurl}"
                                                                : !string.IsNullOrEmpty(submenu2.uploadfile)
                                                                ? $"/uploads/prospectus/{submenu2.uploadfile}"
                                                                : $"/cms/{submenu2.linkname.ToSlug().ToLower()}/{submenu2.pageid}";

                                                                <li>
                                                                    <a href="@subHref1" @actionLink>@submenu2.linkname</a>
                                                                </li>
                                                            }

                                                        </ul>
                                                    </div>
                                                }


                                            </div>
                                            i++;
                                        }


                                    </div>
                                </div>
                            }
                        }

                        @if (menu.pageid == "4")
                        {
                            <div class="mega_dropdown mega_dropdown01 full_investor">
                                <div class=tab-column>
                                    @if (investorlist != null)
                                    {
                                        foreach (var list in investorlist)
                                        {
                                            foreach (var row in list.SubMenus)
                                            {
                                                var hrefinvestor = !string.IsNullOrEmpty(list.rewriteurl)
                                                ? $"/{list.rewriteurl}"
                                                : $"javascript:void()";
                                                <div class=tab-item>
                                                    <div class=accordion_hed>
                                                        <p>@list.Name</p>
                                                        <button class=toggle-btn>
                                                            +
                                                        </button>
                                                        <a href="/investor-relations/@list.Name.ToSlug().ToLower()/@row.linkname.ToSlug().ToLower()/@Convert.ToInt16(list.pageid)/@Convert.ToInt16(row.pageid)" class=streched_link></a>
                                                    </div>
                                                </div>
                                            }
                                            if (list.SubMenus.Count <= 0)
                                            {
                                                var hrefinvestor = !string.IsNullOrEmpty(list.rewriteurl)
                                                ? $"/{list.rewriteurl}"
                                                : $"javascript:void()";
                                                <div class=tab-item>
                                                    <div class=accordion_hed>
                                                        <p>@list.Name</p>
                                                        <button class=toggle-btn>
                                                            +
                                                        </button>
                                                        <a href="/investor-relations/@list.Name.ToSlug().ToLower()/@Convert.ToInt16(list.pageid)" class=streched_link></a>
                                                    </div>
                                                </div>
                                            }
                                        }

                                    }



                                </div>
                            </div>

                        }

                        @if (menu.pageid == "7")
                        {
                            <div class="mega_dropdown mega_dropdown01">
                                <div class="menu_tower_icon1">
                                    <figure><img src="/images/icon2/about-tower1.svg" class="img-fluid"></figure>
                                </div>
                                <div class="menu_tower_icon2">
                                    <figure><img src="/images/icon2/about-tower1.svg" class="img-fluid"></figure>
                                </div>
                                <div class="mega_item_left">
                                    <ul>
                                        @{
                                            int i = 1;
                                        }
                                        @if (productlist != null)
                                        {
                                            foreach (var product in productlist)
                                            {
                                                string targetname = string.Empty;
                                                string activeClass = i == 1 ? "active" : "";
                                                var subHref1 = !string.IsNullOrEmpty(product.rewriteurl)
                                                ? $"/{product.rewriteurl}/{product.pageid}"
                                                : $"/cms/{product.linkname}/{product.pageid}";
                                                if (product.pageid == "3")
                                                {
                                                    subHref1 = $"https://skipperpipes.in/";
                                                    targetname = "Target=_blank";
                                                }

                                                <li class="dropmenu @activeClass" data-target=".drop_menu_@i">
                                                    <a href="@subHref1" @targetname>@product.Name</a>
                                                </li>
                                                i++;
                                            }
                                        }
                                    </ul>
                                </div>
                                <div class="mega_item_right">
                                    @if (productlist != null)
                                    {
                                        int ii = 1;
                                        foreach (var product in productlist)
                                        {
                                            <div class="mega_dropmenu drop_menu_@ii pro_drop show">
                                                <div class="mega_border"></div>
                                                <div class="mega_border">&nbsp;</div>
                                                <div class="mega_overview">

                                                    @Html.Raw(System.Net.WebUtility.HtmlDecode(product.SmallDescription))

                                                </div>
                                                @if (product.pageid == "3")
                                                {
                                                    @* <div class="polymer_link">
                                                        @if (product.SubMenus != null)
                                                        {
                                                            foreach (var submenu in product.SubMenus)
                                                            {
                                                                var href = !string.IsNullOrEmpty(submenu.rewriteurl)
                                                                ? $"/{product.Name}/{submenu.linkname.ToString().ToSlug()}/{submenu.pageid}"
                                                                : $"/cms/{submenu.linkname}/{submenu.pageid}";
                                                                <div class="link_item">
                                                                    <h3>@submenu.linkname</h3>
                                                                    @if (submenu.SubMenus2 != null)
                                                                    {
                                                                        foreach (var submenu2 in submenu.SubMenus2)
                                                                        {
                                                                            var href2 = !string.IsNullOrEmpty(submenu2.rewriteurl)
                                                                            ? $"/{submenu2.rewriteurl}/{submenu2.pageid}"
                                                                            : $"/cms/{submenu2.linkname}/{submenu2.pageid}";
                                                                            <a href="@href2">
                                                                                @submenu2.linkname
                                                                            </a>
                                                                        }
                                                                    }
                                                                </div>
                                                            }
                                                        }
          
                                                    </div> *@
                                                }
                                                else
                                                {
                                                    <div class="mega_overLink">
                                                        <ul class="menu_list">
                                                            @if (product.SubMenus != null)
                                                            {
                                                                foreach (var submenu in product.SubMenus)
                                                                {
                                                                    var href = !string.IsNullOrEmpty(submenu.rewriteurl)
                                                                    ? $"/{submenu.rewriteurl}/{submenu.pageid}"
                                                                    : $"/cms/{submenu.linkname}/{submenu.pageid}";
                                                                    <li>
                                                                        <a href="@href">
                                                                            @submenu.linkname
                                                                        </a>
                                                                    </li>
                                                                }

                                                            }
                                                        </ul>
                                                    </div>
                                                }


                                            </div>

                                            ii++;
                                        }
                                    }


                                </div>
                            </div>

                        }

                        @if(menu.pageid == "8")
                        {
                            <div class="mega_dropdown people_menu mega_dropdown01">
                                <div class="people_left">
                                    <h2>People</h2>
                                    <h3>A Culture of Growth and Engagement</h3>
                                    <div class="read_icon">
                                        <a href="/about-us/company-profile">
                                            <img alt="icon" src="images/icon/plus-icon.svg">
                                        </a>
                                    </div>
                                    <div class="p_icons">
                                        <figure class="abtmenu_icon">
                                            <img alt="icon" src="images/abtmenuarrow.svg">
                                        </figure>
                                    </div>



                                </div>
                                <div class="people_right">
                                    <div class="people_grid">
                                        <div class="people_list">
                                            <figure class="abtmenu_icon"> <img alt="icon" src="/images/people-icon1.webp"> </figure>
                                            <p>Life at Skipper <img alt="icon" src="images/rd-icon.svg"> </p>
                                            <a href="" class="streched_link"></a>
                                        </div>
                                        <div class="people_list">
                                            <figure class="abtmenu_icon"> <img alt="icon" src="/images/people-icon2.webp"> </figure>
                                            <p>Employee Connect Programs <img alt="icon" src="images/rd-icon.svg"> </p>
                                            <a href="" class="streched_link"></a>
                                        </div>
                                        <div class="people_list">
                                            <figure class="abtmenu_icon"> <img alt="icon" src="/images/people-icon3.webp"> </figure>
                                            <p>Talent Management <img alt="icon" src="images/rd-icon.svg"> </p>
                                            <a href="" class="streched_link"></a>
                                        </div>
                                        <div class="people_list">
                                            <figure class="abtmenu_icon"> <img alt="icon" src="/images/people-icon4.webp"> </figure>
                                            <p>Diversity, Equity & Inclusion <img alt="icon" src="images/rd-icon.svg"> </p>
                                            <a href="" class="streched_link"></a>
                                        </div>
                                        <div class="people_list">
                                            <figure class="abtmenu_icon"> <img alt="icon" src="/images/people-icon5.webp"> </figure>
                                            <p>Performance Management <img alt="icon" src="images/rd-icon.svg"> </p>
                                            <a href="" class="streched_link"></a>
                                        </div>
                                        <div class="people_list">
                                            <figure class="abtmenu_icon"> <img alt="icon" src="/images/people-icon6.webp"> </figure>
                                            <p>Current Openings <img alt="icon" src="images/rd-icon.svg"> </p>
                                            <a href="" class="streched_link"></a>
                                        </div>


                                    </div>



                                </div>

                            </div>
                        }


                    </li>

                }

            }

            <li class="globe-dropdown">
                <a class="globe-icon">
                    <img src="/images/globe-icon.png" alt="Globe">
                </a>

                <ul class="globe-menu">
                    <li><a href="https://us.skipperlimited.com/" target="_blank">Skipper North America </a></li>
                    <li><a href="https://skippermetzer.com/" target="_blank">Skipper Metzer</a></li>
                </ul>
            </li>


            <div class=top-humburger>
                <div class="c-hamburger c-hamburger--htx"><a href=javascript:void(0)></a></div>
                <nav class="open sub-menu">
                    <div id=accordian>
                        @if (leftHam != null && leftHam.Count > 0)
                        {
                            <ul class=list-unstyled>
                                @foreach (var ham in leftHam)
                                {
                                    var subHref = !string.IsNullOrEmpty(ham.rewriteurl) ? $"/{ham.rewriteurl}"
                                    : $"/cms/{ham.Name.Replace(" ", "-").ToLower()}/{ham.pageid}";
                                    <li class="@(ham.SubMenus.Count == 0 ? "no_drop_menu" : null)">
                                        <h3>

                                            <a href="@((ham.SubMenus != null && ham.SubMenus.Count > 0) ? "javascript:void(0)" : subHref)">
                                                @ham.Name
                                            </a>
                                        </h3>
                                        @if (ham.SubMenus != null)
                                        {
                                            <ul class=submenu>
                                                @foreach (var sub in ham.SubMenus)
                                                {
                                                    var subHref1 = !string.IsNullOrEmpty(sub.rewriteurl)
                                                    ? $"/{sub.rewriteurl}"
                                                    : $"/cms/{sub.linkname.ToLower().Replace(" ", "-")}/{sub.pageid}";
                                                    <li>  <a href="@subHref1">@sub.linkname</a> </li>
                                                }
                                            </ul>
                                        }

                                    </li>
                                }
                            </ul>
                        }

                    </div>
                </nav>
            </div>
        </ul>
    </nav>
}








