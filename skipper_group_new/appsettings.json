  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "UrlValidationRules": {
    "Rules": [
      {
        "Type": "Block",
        "Pattern": "<|>|'|\"|;|\\(|\\)|\\{|\\}",
        "Action": "RedirectToError"
      },
      {
        "Type": "Block",
        "Pattern": "[\\x00-\\x1F]",
        "Action": "RedirectToError"
      },
      {
        "Type": "Allow",
        "Pattern": "^[a-zA-Z0-9\\-/]+$",
        "Action": "Continue"
      }
    ]
  },

  "AllowedHosts": "*"
}
